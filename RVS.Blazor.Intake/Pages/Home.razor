@page "/"

@* Landing page (issue #695) — a hero band carries the brand and the pitch; the next step
   is a tile below it rather than a full-width button. *@

<PageTitle>RV Intake</PageTitle>

<MudStack AlignItems="AlignItems.Center" Spacing="6" Class="mt-4">
    <MudPaper Elevation="3" Class="pa-8 rounded-lg"
              Style="width: 100%; max-width: 560px; background: var(--mud-palette-secondary); text-align: center;">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <BrandWordmark Variant="BrandWordmarkVariant.Stacked" Reversed="true" Height="96px" />

            <MudText Typo="Typo.h4" Style="color: var(--mud-palette-secondary-text); font-weight: 700;">
                Get your RV back on the road
            </MudText>

            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-secondary-text); opacity: 0.85;">
                Send your service request straight to the service department —
                no app, no account, just a few taps
            </MudText>
        </MudStack>
    </MudPaper>

    @* The "New Service Request" tile (→ /intake) is hidden until there is a searchable directory
       to pick a dealer from (issue #862). From the root there is no location to send it to; customers
       reach intake through their dealer's link (Spec A-13). *@
    <MudGrid Justify="Justify.Center" Spacing="3" Style="width: 100%; max-width: 560px;">
        <MudItem xs="12" sm="6">
            <MudLink Href="/status" Style="text-decoration: none; display: block; height: 100%;">
                <MudPaper Elevation="2" Class="pa-6 rounded-lg"
                          Style="height: 100%; border-top: 4px solid var(--mud-palette-secondary);">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Color="Color.Secondary" Style="font-size: 2.5rem;" />
                        <MudText Typo="Typo.h6" Align="Align.Center" Style="color: var(--mud-palette-text-primary);">
                            Check Request Status
                        </MudText>
                        <MudText Typo="Typo.body2" Align="Align.Center" Style="color: var(--mud-palette-text-secondary);">
                            See updates on a request you already sent.
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudLink>
        </MudItem>
    </MudGrid>
</MudStack>