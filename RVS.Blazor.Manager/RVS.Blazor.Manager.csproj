<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>687649c8-e954-46cd-ac0d-dace41f6fae4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="MudBlazor" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RVS.UI.Shared\RVS.UI.Shared.csproj" />
    <ProjectReference Include="..\RVS.Domain\RVS.Domain.csproj" />
  </ItemGroup>

  <!-- Serve the OSS third-party notices with the published bundle (covers MudBlazor,
       the Blazor WASM runtime, and the other MIT components in this app). -->
  <ItemGroup>
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="wwwroot\THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- New-build prompt (issue #859). The SDK appends SourceRevisionId (the git SHA; CI passes
       -p:SourceRevisionId=$GITHUB_SHA) to the assembly's informational version, which is how the
       running app knows its own build. This writes the same ID to version.json in the published
       wwwroot, so an open tab can tell when a different build has been deployed. Production
       promotes the staging artifact unchanged, so the file carries through. -->
  <Target Name="WriteBuildVersionFile" AfterTargets="Publish" Condition="'$(SourceRevisionId)' != ''">
    <WriteLinesToFile File="$(PublishDir)wwwroot/version.json"
                      Lines="{&quot;buildId&quot;:&quot;$(SourceRevisionId)&quot;}"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
